PORT=3000
JWT_SECRET=troque-esta-chave-em-producao-123
JWT_EXPIRES=8h
COMPANY_NAME=Empresa Demonstracao
# Banco: sem DATABASE_URL roda em SQLite local. Com ela, roda em PostgreSQL (Neon/Supabase/local).
# Neon: dashboard → Connect → copie a string (termine com ?sslmode=require)
# DATABASE_URL=postgresql://neondb_owner:SUASENHA@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# E-mails via Resend (recuperação de senha, boas-vindas). Sem a chave, o app roda sem enviar.
# RESEND_API_KEY=re_sua_chave_aqui
# MAIL_FROM=EstoquePro <onboarding@resend.dev>
# Opcional: cria seu superadmin no seed (node src/seed.js)
# SEED_DEV_EMAIL=voce@email.com
# SEED_DEV_PASS=sua-senha
